# Files that must never be uploaded as theme assets.
# gitignore syntax, applied by the Riseact CLI relative to the theme root.

.git*
.github
node_modules

# end-to-end suite, not part of the theme
test

# CLI credentials: this file holds an access token.
riseact.yml
.riseact

# Build tooling. assets/main.css is the compiled output and IS uploaded;
# everything needed to produce it is not.
package.json
package-lock.json
yarn.lock
tailwind.config.js
.djlintrc
.python-version

# Themes of other installations, kept here for migration: .html files under the
# theme root, which the CLI would otherwise upload as theme assets.
to_migrate

# Repository documentation, not part of the theme.
LICENSE.md
README.md

# Template creati dalla suite e2e (specs/project-campaigns-order.spec.js).
# `riseact theme dev` li scarica dal tema di anteprima: non vanno né committati né rilasciati.
templates/*.e2e-*.json
